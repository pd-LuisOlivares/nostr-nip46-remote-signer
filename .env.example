# Ejemplo de configuracion. Copiar a .env (que no se versiona) y ajustar si hace falta.
# Contiene solo valores ficticios y no sensibles. No incluir aqui secretos reales.

# Puerto del host en el que Docker Compose publica la API (solo en 127.0.0.1).
APP_PORT=8000

# Relay Nostr de referencia (obligatoriamente wss://). Valor por defecto si no se define.
# RELAY_URL=wss://relay.primal.net
# Opcional: un unico grupo TLS (p. ej. X25519). La verificacion del certificado y del nombre se mantiene siempre.
# RELAY_TLS_GROUPS=X25519
