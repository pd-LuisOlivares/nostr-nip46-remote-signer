# PERFIL DE VALIDACION B6.2 (Docker Compose). NO es la configuracion definitiva del producto (decision D-16).
# Reproduce los limites del plan docs/phase-1.0B-B6.2-plan.md (§4). Solo valores NO secretos: aqui nunca van contrasenas, claves ni URI.
#
# Uso (desde la raiz del repositorio; --env-file sustituye al .env local, asi un .env personal no altera esta validacion):
#   docker compose --env-file deploy/b62.env -p nostr-nip46-remote-signer up -d
# Procedimiento completo, importacion de la base y comprobaciones: docs/phase-1.0B-B6.2-plan.md §17.

# Puerto del host (solo 127.0.0.1). 8001 para no coincidir con la demostracion B6.1D (8000). Abrir http://localhost:8001
APP_PORT=8001

# Modo SUPERVISADO (D-17): conserva el comportamiento de validacion de B6.2 (aprobacion humana de cada firma, una firma, sesion acotada, sin reintentos).
# El modo principal del producto es `continuous`; este perfil lo fija a `supervised` de forma explicita.
SIGNER_MODE=supervised

# Relay y origen reales de B6.2 (el relay solo se contacta al pulsar "Iniciar firmante" en el panel; arrancar el contenedor NO abre conexiones externas)
RELAY_URL=wss://relay.primal.net
RELAY_TLS_GROUPS=X25519
SERVICE_ORIGIN=https://stacker.news

# Limites exactos de la prueba (una firma, ventana de 15 minutos: la sesion y la conexion caducan antes del limite duro)
SIGNER_WINDOW_S=120
SECRET_TTL_S=600
APPROVAL_TTL_S=120
MAX_SIGNATURES=1
MAX_REQUESTS=30
SESSION_TTL_S=720
CONNECTION_TTL_S=720
JWT_TTL_S=900

# Usuario del administrador. Solo se usa si la base NO tiene administrador; con la base importada (plan §17) no hace falta contrasena en el entorno.
ADMIN_USERNAME=b62-admin
