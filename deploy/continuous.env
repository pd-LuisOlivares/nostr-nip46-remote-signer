# PERFIL DEL ENTORNO LOCAL DEFINITIVO (Docker Compose, modo CONTINUO; decision D-17). Solo valores NO secretos: aqui nunca van contrasenas, claves ni URI.
# No sustituye a deploy/b62.env (perfil de validacion SUPERVISADO de B6.2, que se conserva intacto como via de recuperacion).
#
# Uso (desde la raiz del repositorio; --env-file sustituye al .env local):
#   docker compose --env-file deploy/continuous.env -p nostr-nip46-remote-signer up -d --no-build --pull never app
# Construccion de la imagen (necesita PyPI; la imagen base ya esta en local y se fija por digest, decision D-6):
#   PYTHON_IMAGE=python@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b docker compose --env-file deploy/continuous.env -p nostr-nip46-remote-signer build app
# Volver al entorno anterior (la imagen manual-b61d NO se sobrescribe y el volumen no se toca):
#   APP_IMAGE=nostr-nip46-remote-signer:manual-b61d docker compose --env-file deploy/b62.env -p nostr-nip46-remote-signer up -d --no-build --pull never app

# Imagen NUEVA del producto con el codigo definitivo. Etiqueta propia: no pisa `manual-b61d` ni `dev`.
APP_IMAGE=nostr-nip46-remote-signer:d17-continuous

# Puerto del host (solo 127.0.0.1)
APP_PORT=8001

# Modo continuo, explicito (es tambien el valor por defecto). Los limites y plazos son los de app/config.py para este modo:
# SECRET_TTL_S=300, CONNECTION_TTL_S=28800, APPROVAL_TTL_S=300, REQUESTS_PER_MIN=30 (por conexion) y 120 globales por minuto.
SIGNER_MODE=continuous

# Relay y origen reales de la validacion con Stacker News. Arrancar el contenedor NO abre conexiones externas: el relay solo se contacta al pulsar «Iniciar firmante».
RELAY_URL=wss://relay.primal.net
RELAY_TLS_GROUPS=X25519
SERVICE_ORIGIN=https://stacker.news

# Usuario del administrador (solo se usa si la base no tiene administrador; la base del volumen ya lo tiene)
ADMIN_USERNAME=b62-admin
